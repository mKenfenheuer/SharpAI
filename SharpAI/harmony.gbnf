# harmony.gbnf
# GBNF grammar for the OpenAI "Harmony" response format (channels, roles, messages, tool calls)

root ::= harmony-root
harmony-root ::= analysisblock commentaryblock messageblock

# Token definitions
START ::= "<|start|>"
END ::= "<|end|>"
MESSAGE ::= "<|message|>"
CHANNEL ::= "<|channel|>"
CONSTRAIN ::= "<|constrain|>"

# Generic message block: <|start|>{header}<|message|>{content}<|end|>
analysisblock ::= CHANNEL "analysis"  MESSAGE text END (commentaryblock | messageblock)
commentaryblock ::= START "assistant" CHANNEL "commentary" (commentaryblock-toolcall | commentaryblock-message)
commentaryblock-toolcall ::= " to=" ("browser." | "python." | "functions.") identification (" code" | " "? constraint) MESSAGE text END
commentaryblock-message ::= MESSAGE text END messageblock
messageblock ::= START "assistant" CHANNEL "final" (" " constraint)? MESSAGE text END

constraint ::= CONSTRAIN constrainttype 
constrainttype ::= identification | "json"

# IDENT: alphanumeric plus underscore, can include dashes after first character
identification ::= ([A-Za-z0-9_-] | ".")*

# TEXT: any run of characters not containing '<', newlines allowed
text ::= safechar*

safechar ::= "<" safeangle | [^<]

safeangle ::= "|" [^a-z] "|" ">" | [^|] 