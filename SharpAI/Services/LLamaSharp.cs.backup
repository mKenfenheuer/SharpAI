using LLama;
using LLama.Common;
using SharpAI.Models;
using SharpAI.Services.Harmony;
using System.Text;

namespace SharpAI.Services;

public class LLamaSharpService : IDisposable
{
    private readonly LLamaModelManager _modelManager;
    private readonly ILogger<LLamaSharpService> _logger;
    private readonly StreamingInferenceEngine _streamingEngine;
    private readonly HarmonyParser _harmonyParser;
    private readonly HarmonyFormatter _harmonyFormatter;

    public LLamaSharpService(
        LLamaModelManager modelManager, 
        ILogger<LLamaSharpService> logger,
        StreamingInferenceEngine streamingEngine,
        HarmonyParser harmonyParser,
        HarmonyFormatter harmonyFormatter)
    {
        _modelManager = modelManager;
        _logger = logger;
        _streamingEngine = streamingEngine;
        _harmonyParser = harmonyParser;
        _harmonyFormatter = harmonyFormatter;
    }

    public async Task<ChatCompletionResponse> GenerateChatCompletionAsync(ChatCompletionRequest request)
    {
        var requestedModel = request.Model ?? "gpt-4";
        _logger.LogInformation("Requested model: {RequestedModel}", requestedModel);

        ModelInstance modelInstance;
        try
        {
            modelInstance = await _modelManager.GetModelAsync(requestedModel);
        }
        catch (ArgumentException ex)
        {
            _logger.LogError(ex, "Invalid model requested: {ModelName}", requestedModel);
            throw new ArgumentException($"Model '{requestedModel}' is not available. Use /v1/models to see available models.", ex);
        }

        var inferenceParams = LLamaUtilities.CreateInferenceParams(request, modelInstance);
        
        // Prepare messages with default system prompt if needed
        var allMessages = PrepareMessages(request.Messages);

        // Use unified streaming engine but collect all results
        var contentBuilder = new StringBuilder();
        ParsedResponse? finalParsedResponse = null;
        var reasoningTokens = 0;

        await foreach (var result in _streamingEngine.GenerateStreamAsync(allMessages, request, modelInstance, inferenceParams))
        {
            if (result.IsComplete && result.ParsedResponse != null)
            {
                finalParsedResponse = result.ParsedResponse;
                break;
            }

            if (result.Delta?.FinalContent != null)
            {
                contentBuilder.Append(result.Delta.FinalContent);
            }
        }

        // Use the parsed response from streaming engine
        var parsedResponse = finalParsedResponse ?? new ParsedResponse
        {
            Content = contentBuilder.ToString(),
            ToolCalls = new List<HarmonyToolCall>(),
            FunctionCall = false,
            Reasoning = null
        };

        var assistantMessage = new ChatMessage { Role = ChatRole.Assistant, Content = parsedResponse.Content };
        var finishReason = "stop";

        // Check if the response contains function calls
        if (parsedResponse.ToolCalls.Any() || parsedResponse.FunctionCall)
        {
            assistantMessage.ToolCalls = LLamaUtilities.ConvertHarmonyToolCalls(parsedResponse.ToolCalls);
            assistantMessage.Content = null;
            finishReason = "tool_calls";

            // If parallel tool calls are disabled, only keep the first one
            if (request.ParallelToolCalls == false)
            {
                assistantMessage.ToolCalls = assistantMessage.ToolCalls.Take(1).ToList();
            }
        }

        // Calculate reasoning tokens if reasoning was used
        if (request.ReasoningEffort.HasValue && !string.IsNullOrEmpty(parsedResponse.Reasoning))
        {
            reasoningTokens = LLamaUtilities.EstimateReasoningTokens(parsedResponse.Reasoning, request.ReasoningEffort.Value);
        }

        var response = new ChatCompletionResponse
        {
            Id = LLamaUtilities.CreateCompletionId(),
            Object = CompletionObjectType.ChatCompletion,
            Created = LLamaUtilities.GetCurrentUnixTimestamp(),
            Model = request.Model,
            Choices = new List<ChatCompletionChoice>
            {
                new ChatCompletionChoice
                {
                    Index = 0,
                    Message = assistantMessage,
                    FinishReason = finishReason
                }
            },
            Usage = new TokenUsage
            {
                PromptTokens = LLamaUtilities.EstimateTokens(_harmonyFormatter.FormatPrompt(allMessages, request.Tools?.Any() == true, request.ReasoningEffort ?? ReasoningEffortLevel.Medium, request.Tools)),
                CompletionTokens = LLamaUtilities.EstimateTokens(parsedResponse.Content ?? ""),
                ReasoningTokens = reasoningTokens > 0 ? reasoningTokens : null,
                TotalTokens = 0 // Will be calculated
            }
        };

        response.Usage.TotalTokens = response.Usage.PromptTokens + response.Usage.CompletionTokens + reasoningTokens;
        return response;
    }

    public async IAsyncEnumerable<ChatCompletionChunk> GenerateChatCompletionStreamAsync(ChatCompletionRequest request)
    {
        var requestedModel = request.Model ?? "gpt-4"; // Default to gpt-4 which maps to gpt-oss-20b
        _logger.LogInformation("Requested model for streaming: {RequestedModel}", requestedModel);
        
        // Model mapping will be handled by the model manager
        var modelName = requestedModel;
        
        ModelInstance modelInstance;
        try
        {
            modelInstance = await _modelManager.GetModelAsync(modelName);
        }
        catch (ArgumentException ex)
        {
            _logger.LogError(ex, "Invalid model requested for streaming: {ModelName}", modelName);
            throw new ArgumentException($"Model '{modelName}' is not available. Use /v1/models to see available models.", ex);
        }
        
        var inferenceParams = CreateInferenceParams(request, modelInstance);
        var completionId = $"chatcmpl-{Guid.NewGuid():N}";
        var created = DateTimeOffset.UtcNow.ToUnixTimeSeconds();

        // Prepare messages with additional context
        var allMessages = new List<ChatMessage>(request.Messages);

        // Add default system prompt if none provided
        if (!allMessages.Any(m => m.Role == ChatRole.System))
        {
            var defaultSystemPrompt = "You are a helpful and knowledgeable assistant.";
            allMessages.Insert(0, new ChatMessage { Role = ChatRole.System, Content = defaultSystemPrompt });
        }

        // Check if tools are available and should be used
        var shouldUseFunctions = request.Tools?.Any() == true && 
                                 (request.ToolChoice != ToolChoice.None);

        // Function calling and reasoning effort will be handled in harmony format - no need for separate messages

        // Send initial chunk
        yield return new ChatCompletionChunk
        {
            Id = completionId,
            Object = CompletionObjectType.ChatCompletionChunk,
            Created = created,
            Model = request.Model,
            Choices = new List<ChatCompletionChunkChoice>
            {
                new ChatCompletionChunkChoice
                {
                    Index = 0,
                    Delta = new ChatMessage { Role = ChatRole.Assistant, Content = "" },
                    FinishReason = null
                }
            }
        };

        // Apply harmony format to the prompt
        var formattedPrompt = ApplyHarmonyFormat(allMessages, shouldUseFunctions, request.ReasoningEffort ?? ReasoningEffortLevel.Medium, request.Tools);

        var responseBuilder = new StringBuilder();
        var currentChannel = "";
        var analysisBuffer = new StringBuilder();
        var finalBuffer = new StringBuilder();
        var lastStreamedLength = 0;
        
        await foreach (var text in modelInstance.Executor!.InferAsync(formattedPrompt, inferenceParams))
        {
            responseBuilder.Append(text);
            var currentResponse = responseBuilder.ToString();
            
            // Parse current response to detect harmony channels
            var messages = ParseHarmonyMessages(currentResponse);
            
            // Stream analysis content (reasoning) - we can show this in real-time for debugging but normally shouldn't
            var analysisMessages = messages.Where(m => m.Channel == "analysis").ToList();
            foreach (var analysisMsg in analysisMessages)
            {
                if (analysisMsg.Content.Length > analysisBuffer.Length)
                {
                    var newAnalysisContent = analysisMsg.Content.Substring(analysisBuffer.Length);
                    analysisBuffer.Append(newAnalysisContent);
                    // Note: In production, analysis content should not be streamed to users
                    // as it doesn't meet the same safety standards
                }
            }
            
            // Stream final content to user
            var finalMessages = messages.Where(m => m.Channel == "final").ToList();
            foreach (var finalMsg in finalMessages)
            {
                if (finalMsg.Content.Length > lastStreamedLength)
                {
                    var newContent = finalMsg.Content.Substring(lastStreamedLength);
                    lastStreamedLength = finalMsg.Content.Length;
                    
                    if (!string.IsNullOrEmpty(newContent))
                    {
                        yield return new ChatCompletionChunk
                        {
                            Id = completionId,
                            Object = CompletionObjectType.ChatCompletionChunk,
                            Created = created,
                            Model = request.Model,
                            Choices = new List<ChatCompletionChunkChoice>
                            {
                                new ChatCompletionChunkChoice
                                {
                                    Index = 0,
                                    Delta = new ChatMessage { Role = ChatRole.Assistant, Content = newContent },
                                    FinishReason = null
                                }
                            }
                        };
                    }
                }
            }
            
            // Check if we hit a completion stop token
            if (currentResponse.Contains("<|call|>") || currentResponse.Contains("<|return|>"))
            {
                break;
            }
        }

        // Check for tool calls in the complete response
        var completeResponse = responseBuilder.ToString();
        
        // Parse harmony response format
        var parsedCompleteResponse = ParseHarmonyResponse(completeResponse);
        
        // Apply response format validation and processing for streaming
        if (request.ResponseFormat != null)
        {
            parsedCompleteResponse.Content = ProcessResponseFormat(parsedCompleteResponse.Content, request.ResponseFormat);
        }
        
        var toolCalls = new List<ToolCall>();
        var finishReason = "stop";

        toolCalls = ConvertHarmonyToolCalls(parsedCompleteResponse.ToolCalls);
        if (toolCalls.Any() || parsedCompleteResponse.FunctionCall)
        {
            finishReason = "tool_calls";
        }

        // Send tool calls if present
        if (toolCalls.Any())
        {
            foreach (var toolCall in toolCalls)
            {
                yield return new ChatCompletionChunk
                {
                    Id = completionId,
                    Object = CompletionObjectType.ChatCompletionChunk,
                    Created = created,
                    Model = request.Model,
                    Choices = new List<ChatCompletionChunkChoice>
                    {
                        new ChatCompletionChunkChoice
                        {
                            Index = 0,
                            Delta = new ChatMessage 
                            { 
                                Role = ChatRole.Assistant,
                                ToolCalls = new List<ToolCall> { toolCall }
                            },
                            FinishReason = null
                        }
                    }
                };
            }
        }

        // Send final chunk with usage if requested
        var finalChunk = new ChatCompletionChunk
        {
            Id = completionId,
            Object = CompletionObjectType.ChatCompletionChunk,
            Created = created,
            Model = request.Model,
            Choices = new List<ChatCompletionChunkChoice>
            {
                new ChatCompletionChunkChoice
                {
                    Index = 0,
                    Delta = new ChatMessage { Role = ChatRole.Assistant },
                    FinishReason = finishReason
                }
            }
        };

        // Include usage if stream_options.include_usage is true
        if (request.StreamOptions?.IncludeUsage == true)
        {
            var reasoningTokens = request.ReasoningEffort.HasValue ? 
                EstimateReasoningTokens(parsedCompleteResponse.Reasoning ?? "", request.ReasoningEffort.Value) : 0;
            
            finalChunk.Usage = new TokenUsage
            {
                PromptTokens = EstimateTokens(formattedPrompt),
                CompletionTokens = EstimateTokens(parsedCompleteResponse.Content),
                ReasoningTokens = reasoningTokens > 0 ? reasoningTokens : null,
                TotalTokens = 0
            };
            finalChunk.Usage.TotalTokens = finalChunk.Usage.PromptTokens + finalChunk.Usage.CompletionTokens + reasoningTokens;
        }

        yield return finalChunk;
    }



    private InferenceParams CreateInferenceParams(ChatCompletionRequest request, ModelInstance modelInstance)
    {
        var repeatPenalty = 1.0f;
        
        // Apply penalties if specified
        if (request.FrequencyPenalty.HasValue)
        {
            repeatPenalty = (float)(1.0 + Math.Abs(request.FrequencyPenalty.Value));
        }
        else if (request.PresencePenalty.HasValue)
        {
            // Presence penalty affects the likelihood of new tokens
            repeatPenalty = (float)(1.0 + Math.Abs(request.PresencePenalty.Value));
        }

        var samplingPipeline = new DefaultSamplingPipeline()
        {
            Temperature = (float)(request.Temperature ?? 0.7),
            TopP = (float)(request.TopP ?? 1.0),
            RepeatPenalty = repeatPenalty,
            PreventEOS = false
        };

        // Get stop sequences from model EOS token and request
        var stopSequences = GetStopSequencesFromModel(request, modelInstance);

        return new InferenceParams
        {
            MaxTokens = request.MaxCompletionTokens ?? request.MaxTokens ?? int.MaxValue,
            AntiPrompts = stopSequences,
            SamplingPipeline = samplingPipeline,
            DecodeSpecialTokens = true
        };
    }

    private List<string> GetStopSequencesFromModel(ChatCompletionRequest request, ModelInstance modelInstance)
    {
        var stopSequences = new List<string>();

        // For gpt-oss with harmony format, only stop on completion tokens, not intermediate <|end|>
        stopSequences.AddRange(new[] { "<|return|>", "<|call|>" });

        // Add any custom stop sequences from the request
        if (request.Stop != null)
        {
            if (request.Stop is string singleStop)
            {
                stopSequences.Add(singleStop);
            }
            else if (request.Stop is JsonElement jsonElement && jsonElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var element in jsonElement.EnumerateArray())
                {
                    if (element.ValueKind == JsonValueKind.String)
                    {
                        var stopSeq = element.GetString();
                        if (!string.IsNullOrEmpty(stopSeq))
                        {
                            stopSequences.Add(stopSeq);
                        }
                    }
                }
            }
        }

        _logger.LogInformation("Harmony stop sequences: {StopSequences}", string.Join(", ", stopSequences.Distinct().ToList()));

        return stopSequences.Distinct().ToList();
    }

    private int EstimateTokens(string text)
    {
        // Simple token estimation - approximately 4 characters per token
        return (int)Math.Ceiling(text.Length / 4.0);
    }

    private int EstimateReasoningTokens(string text, ReasoningEffortLevel effort)
    {
        var baseTokens = EstimateTokens(text);
        
        return effort switch
        {
            ReasoningEffortLevel.Minimal => (int)(baseTokens * 0.1),
            ReasoningEffortLevel.Low => (int)(baseTokens * 0.3),
            ReasoningEffortLevel.Medium => (int)(baseTokens * 0.5),
            ReasoningEffortLevel.High => (int)(baseTokens * 0.8),
            _ => 0
        };
    }

    private string CreateHarmonyToolsDefinition(List<ToolDefinition> tools)
    {
        var toolsBuilder = new StringBuilder();
        toolsBuilder.AppendLine("# Tools");
        toolsBuilder.AppendLine();
        toolsBuilder.AppendLine("## functions");
        toolsBuilder.AppendLine();
        toolsBuilder.AppendLine("namespace functions {");
        toolsBuilder.AppendLine();

        foreach (var tool in tools)
        {
            if (tool.Function != null)
            {
                // Add description as comment
                if (!string.IsNullOrEmpty(tool.Function.Description))
                {
                    toolsBuilder.AppendLine($"// {tool.Function.Description}");
                }

                // Convert parameters to TypeScript-like syntax
                var parametersDefinition = ConvertParametersToTypeScript(tool.Function.Parameters);
                
                if (string.IsNullOrEmpty(parametersDefinition))
                {
                    toolsBuilder.AppendLine($"type {tool.Function.Name} = () => any;");
                }
                else
                {
                    toolsBuilder.AppendLine($"type {tool.Function.Name} = (_: {parametersDefinition}) => any;");
                }
                
                toolsBuilder.AppendLine();
            }
        }

        toolsBuilder.AppendLine("} // namespace functions");
        return toolsBuilder.ToString();
    }

    private string ConvertParametersToTypeScript(object? parameters)
    {
        if (parameters == null) return "";

        try
        {
            var jsonElement = JsonSerializer.Deserialize<JsonElement>(parameters.ToString() ?? "");
            
            if (jsonElement.ValueKind == JsonValueKind.Object && jsonElement.TryGetProperty("properties", out var properties))
            {
                var tsBuilder = new StringBuilder();
                tsBuilder.Append("{");
                
                var props = new List<string>();
                foreach (var prop in properties.EnumerateObject())
                {
                    var propName = prop.Name;
                    var propDef = prop.Value;
                    
                    var tsType = "any";
                    var description = "";
                    var isRequired = false;

                    if (propDef.TryGetProperty("type", out var typeElement))
                    {
                        tsType = typeElement.GetString() switch
                        {
                            "string" => "string",
                            "number" => "number",
                            "integer" => "number",
                            "boolean" => "boolean",
                            "array" => "any[]",
                            "object" => "any",
                            _ => "any"
                        };
                    }

                    if (propDef.TryGetProperty("description", out var descElement))
                    {
                        description = descElement.GetString() ?? "";
                    }

                    if (propDef.TryGetProperty("enum", out var enumElement))
                    {
                        var enumValues = enumElement.EnumerateArray()
                            .Select(e => $"\"{e.GetString()}\"")
                            .ToArray();
                        tsType = string.Join(" | ", enumValues);
                    }

                    // Check if required (simplified - would need to check required array in schema)
                    var propDeclaration = isRequired ? propName : $"{propName}?";
                    
                    if (!string.IsNullOrEmpty(description))
                    {
                        props.Add($"\n// {description}\n{propDeclaration}: {tsType}");
                    }
                    else
                    {
                        props.Add($"{propDeclaration}: {tsType}");
                    }
                }
                
                tsBuilder.Append(string.Join(",\n", props));
                tsBuilder.Append("\n}");
                return tsBuilder.ToString();
            }
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to convert parameters to TypeScript format");
        }

        return "";
    }



    private List<ToolCall> ConvertHarmonyToolCalls(List<HarmonyToolCall> harmonyToolCalls)
    {
        var toolCalls = new List<ToolCall>();

        foreach (var harmonyCall in harmonyToolCalls)
        {
            try
            {
                var toolCall = new ToolCall
                {
                    Id = $"call_{Guid.NewGuid():N}",
                    Type = ToolType.Function,
                    Function = new FunctionCall
                    {
                        Name = harmonyCall.Name,
                        Arguments = harmonyCall.Arguments
                    }
                };
                
                toolCalls.Add(toolCall);
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Failed to convert harmony tool call: {Name}", harmonyCall.Name);
                continue;
            }
        }

        return toolCalls;
    }

    private string CreateResponseFormatPrompt(ResponseFormat responseFormat)
    {
        return responseFormat.Type switch
        {
            ResponseFormatType.JsonObject => 
                "You must respond with valid JSON only. Do not include any text outside of the JSON object. " +
                "Ensure your response is properly formatted JSON that can be parsed.",

            ResponseFormatType.JsonSchema when responseFormat.JsonSchema != null => 
                CreateJsonSchemaPrompt(responseFormat.JsonSchema),

            ResponseFormatType.Text or null => 
                "", // No special formatting needed for text

            _ => ""
        };
    }

    private string CreateJsonSchemaPrompt(JsonSchemaFormat jsonSchema)
    {
        var prompt = $"You must respond with valid JSON that strictly follows the schema for '{jsonSchema.Name}'.";
        
        if (!string.IsNullOrEmpty(jsonSchema.Description))
        {
            prompt += $" {jsonSchema.Description}";
        }

        if (jsonSchema.Schema != null)
        {
            var schemaJson = JsonSerializer.Serialize(jsonSchema.Schema, new JsonSerializerOptions 
            { 
                PropertyNamingPolicy = JsonNamingPolicy.SnakeCaseLower,
                WriteIndented = true 
            });
            prompt += $"\n\nRequired JSON Schema:\n{schemaJson}";
        }

        if (jsonSchema.Strict == true)
        {
            prompt += "\n\nIMPORTANT: Strict schema adherence is required. You must follow the schema exactly with no deviations.";
        }

        prompt += "\n\nRespond ONLY with the JSON object. Do not include any explanation or text outside the JSON.";
        
        return prompt;
    }

    private string ProcessResponseFormat(string responseText, ResponseFormat responseFormat)
    {
        if (responseFormat.Type == ResponseFormatType.JsonObject || 
            responseFormat.Type == ResponseFormatType.JsonSchema)
        {
            return ExtractAndValidateJson(responseText);
        }
        
        return responseText;
    }

    private string ExtractAndValidateJson(string responseText)
    {
        try
        {
            // Try to find JSON content in the response
            var jsonMatch = Regex.Match(responseText, @"\{.*\}", RegexOptions.Singleline);
            if (jsonMatch.Success)
            {
                var jsonText = jsonMatch.Value;

                // Validate that it's proper JSON
                JsonDocument.Parse(jsonText);
                return jsonText;
            }

            // If no JSON found, try to parse the entire response as JSON
            JsonDocument.Parse(responseText);
            return responseText;
        }
        catch (JsonException)
        {
            // If JSON is invalid, wrap the response in a simple JSON object
            var escapedText = JsonSerializer.Serialize(responseText);
            return $"{{\"response\": {escapedText}}}";
        }
    }
    
    private string ApplyHarmonyFormat(List<ChatMessage> messages, bool hasFunctions, ReasoningEffortLevel reasoningEffort, List<ToolDefinition>? tools = null)
    {
        var prompt = new StringBuilder();

        // System message with harmony format
        prompt.AppendLine($"<|start|>system<|message|>You are ChatGPT, a large language model trained by OpenAI.");
        prompt.AppendLine("Knowledge cutoff: 2024-06");
        prompt.AppendLine($"Current date: {DateTime.Now:yyyy-MM-dd}");
        prompt.AppendLine();
        prompt.AppendLine($"Reasoning: {reasoningEffort.ToString().ToLower()}");
        prompt.AppendLine();
        prompt.AppendLine("# Valid channels: analysis, commentary, final. Channel must be included for every message.");
        
        if (hasFunctions)
        {
            prompt.AppendLine("Calls to these tools must go to the commentary channel: 'functions'.");
        }
        
        prompt.AppendLine("<|end|>");

        // Create developer message with instructions and tools
        var systemMessages = messages.Where(m => m.Role == ChatRole.System).ToList();
        var instructions = systemMessages.Any() ? 
            string.Join("\n\n", systemMessages.Select(m => m.Content?.ToString())) : 
            "You are a helpful assistant.";

        prompt.AppendLine($"<|start|>developer<|message|># Instructions");
        prompt.AppendLine();
        prompt.AppendLine(instructions);

        // Add tools definition if functions are available
        if (hasFunctions && tools?.Any() == true)
        {
            prompt.AppendLine();
            prompt.AppendLine(CreateHarmonyToolsDefinition(tools));
        }

        prompt.AppendLine("<|end|>");

        // Add conversation messages (excluding system messages as they're in developer section)
        var conversationMessages = messages.Where(m => m.Role != ChatRole.System).ToList();
        
        for (int i = 0; i < conversationMessages.Count; i++)
        {
            var message = conversationMessages[i];

            var role = message.Role switch
            {
                ChatRole.User => "user",
                ChatRole.Assistant => "assistant",
                ChatRole.Tool => GetToolName(message),
                _ => "user"
            };

            var content = message.Content?.ToString() ?? "";
            
            if (message.Role == ChatRole.Tool)
            {
                // Tool messages have special format: <|start|>toolname to=assistant<|channel|>commentary<|message|>content<|end|>
                prompt.AppendLine($"<|start|>{role} to=assistant<|channel|>commentary<|message|>{content}<|end|>");
            }
            else if (!string.IsNullOrEmpty(content))
            {
                prompt.AppendLine($"<|start|>{role}<|message|>{content}<|end|>");
            }
        }

        // Start assistant response
        prompt.Append("<|start|>assistant");

        return prompt.ToString();
    }

    private string GetToolName(ChatMessage message)
    {
        // Extract tool name from message context or use default
        // This would need to be implemented based on how tool messages are structured
        return "functions.tool_result";
    }



    private ParsedResponse ParseHarmonyResponse(string rawResponse)
    {
        var response = new ParsedResponse()
        {
            Content = rawResponse,
            FunctionCall = false,
            Reasoning = null,
            ToolCalls = new List<HarmonyToolCall>()
        };

        try
        {
            // Parse harmony format messages
            var messages = ParseHarmonyMessages(rawResponse);
            _logger.LogDebug("Parsed {MessageCount} harmony messages from response", messages.Count);
            
            // Extract content from final channel
            var finalMessages = messages.Where(m => m.Channel == "final").ToList();
            if (finalMessages.Any())
            {
                response.Content = string.Join(" ", finalMessages.Select(m => m.Content));
                _logger.LogDebug("Extracted final channel content: {Content}", response.Content);
            }

            // Extract reasoning from analysis channel (but don't include in response by default)
            var analysisMessages = messages.Where(m => m.Channel == "analysis").ToList();
            if (analysisMessages.Any())
            {
                response.Reasoning = string.Join("\n", analysisMessages.Select(m => m.Content));
            }

            // Extract tool calls from commentary channel
            var toolCalls = messages.Where(m => m.Channel == "commentary" && !string.IsNullOrEmpty(m.Recipient)).ToList();
            foreach (var toolCall in toolCalls)
            {
                if (toolCall.Recipient?.StartsWith("functions.") == true)
                {
                    response.ToolCalls.Add(new HarmonyToolCall
                    {
                        Name = toolCall.Recipient.Substring("functions.".Length),
                        Arguments = toolCall.Content,
                        Recipient = toolCall.Recipient
                    });
                    response.FunctionCall = true;
                }
            }

            // If no final channel content found, try to extract from the raw response
            if (string.IsNullOrEmpty(response.Content))
            {
                _logger.LogDebug("No final channel content found, extracting from raw response");
                response.Content = ExtractUserReadableContent(rawResponse);
                _logger.LogDebug("Extracted user-readable content: {Content}", response.Content);
            }

            return response;
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to parse harmony response format, using raw response");
            response.Content = rawResponse;
            return response;
        }
    }

    private List<HarmonyMessage> ParseHarmonyMessages(string response)
    {
        var messages = new List<HarmonyMessage>();
        
        // Pattern to match harmony messages with flexible ordering
        var messagePattern = @"<\|start\|>([^<|]+?)(?:<\|channel\|>([^<|]+?))?(?:\s+to=([^\s<|]+?))?(?:\s*<\|constrain\|>\s*([^<|]+?))?<\|message\|>(.*?)(?:<\|end\|>|<\|call\|>|<\|return\|>|$)";
        var matches = Regex.Matches(response, messagePattern, RegexOptions.Singleline | RegexOptions.IgnoreCase);

        foreach (Match match in matches)
        {
            var role = match.Groups[1].Value.Trim();
            var channel = match.Groups[2].Success ? match.Groups[2].Value.Trim() : null;
            var recipient = match.Groups[3].Success ? match.Groups[3].Value.Trim() : null;
            var constraint = match.Groups[4].Success ? match.Groups[4].Value.Trim() : null;
            var content = match.Groups[5].Value.Trim();

            messages.Add(new HarmonyMessage
            {
                Role = role,
                Channel = channel,
                Recipient = recipient,
                Constraint = constraint,
                Content = content
            });
        }

        return messages;
    }

    private string ExtractUserReadableContent(string rawResponse)
    {
        try
        {
            // First try to find final channel content
            var finalMatch = Regex.Match(rawResponse, @"<\|channel\|>final<\|message\|>(.*?)(?:<\|return\|>|<\|end\|>|$)", RegexOptions.Singleline | RegexOptions.IgnoreCase);
            if (finalMatch.Success && !string.IsNullOrEmpty(finalMatch.Groups[1].Value.Trim()))
            {
                return finalMatch.Groups[1].Value.Trim();
            }

            // If no final channel, look for any assistant message that's not analysis
            var assistantMatches = Regex.Matches(rawResponse, @"<\|start\|>assistant<\|channel\|>([^<]+)<\|message\|>(.*?)(?:<\|end\|>|<\|return\|>|<\|call\|>|$)", RegexOptions.Singleline | RegexOptions.IgnoreCase);
            
            foreach (Match match in assistantMatches)
            {
                var channel = match.Groups[1].Value.Trim();
                var content = match.Groups[2].Value.Trim();
                
                // Skip analysis channel, return final or commentary content
                if (channel != "analysis" && !string.IsNullOrEmpty(content))
                {
                    return content;
                }
            }

            // Last resort: look for any content after assistant without channel
            var simpleMatch = Regex.Match(rawResponse, @"<\|start\|>assistant[^<]*<\|message\|>(.*?)(?:<\|end\|>|<\|return\|>|<\|call\|>|$)", RegexOptions.Singleline | RegexOptions.IgnoreCase);
            if (simpleMatch.Success && !string.IsNullOrEmpty(simpleMatch.Groups[1].Value.Trim()))
            {
                return simpleMatch.Groups[1].Value.Trim();
            }

            // If all else fails, return a helpful message
            return "I'm processing your request...";
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Failed to extract user-readable content from response");
            return "I'm processing your request...";
        }
    }



    public void Dispose()
    {
        _modelManager?.Dispose();
    }
}

internal class ParsedResponse
{
    public string Content { get; internal set; }
    public bool FunctionCall { get; internal set; }
    public string Reasoning { get; internal set; }
    public List<HarmonyToolCall> ToolCalls { get; internal set; } = new List<HarmonyToolCall>();
}

internal class HarmonyMessage
{
    public string Role { get; set; }
    public string? Channel { get; set; }
    public string? Recipient { get; set; }
    public string? Constraint { get; set; }
    public string Content { get; set; }
}

internal class HarmonyToolCall
{
    public string Name { get; set; }
    public string Arguments { get; set; }
    public string Recipient { get; set; }
}