# FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04 AS base
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04 AS base
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    ca-certificates \
    cuda-compat-13-0 \
    && rm -rf /var/lib/apt/lists/*

# Install .NET 9 runtime
RUN wget https://packages.microsoft.com/config/ubuntu/22.04/packages-microsoft-prod.deb -O packages-microsoft-prod.deb \
    && dpkg -i packages-microsoft-prod.deb \
    && rm packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y aspnetcore-runtime-9.0 \
    && rm -rf /var/lib/apt/lists/*

# Install FFmpeg for audio processing
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
EXPOSE 80
EXPOSE 443

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["SharpAI.csproj", "."]
COPY . .

RUN dotnet remove package Whisper.net.Runtime
RUN dotnet add package Whisper.net.Runtime.Cuda
RUN dotnet add package Whisper.net.Runtime.Cuda.Linux
RUN dotnet restore "SharpAI.csproj"
WORKDIR "/src"
RUN dotnet build "SharpAI.csproj" -c Release -o /app/build

FROM build AS publish
# ...existing code...
# Changed to publish a self-contained linux-x64 application
RUN dotnet publish "SharpAI.csproj" -c Release -r linux-x64 --self-contained true -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
RUN cp /runtimes/cuda/linux-x64/*.so /runtimes/linux-x64/

# ensure the self-contained native executable is runnable
RUN if [ -f /app/SharpAI ]; then chmod +x /app/SharpAI; fi

EXPOSE 80
ENV ASPNETCORE_HTTP_PORTS=80
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Run the self-contained native executable instead of 'dotnet SharpAI.dll'
ENTRYPOINT ["./SharpAI"]