char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
customer-address-kv ::= "\"customer_address\"" space ":" space string
customer-address-rest ::= ( "," space service-description-kv )? service-description-rest
customer-name-kv ::= "\"customer_name\"" space ":" space string
date ::= [0-9]{4} "-" ( "0" [1-9] | "1" [0-2] ) "-" ( "0" [1-9] | [1-2] [0-9] | "3" [0-1] )
date-string ::= "\"" date "\"" space
decimal-part ::= [0-9]{1,16}
iban-kv ::= "\"iban\"" space ":" space string
integral-part ::= [0] | [1-9] [0-9]{0,15}
invoice-date ::= date-string
invoice-date-kv ::= "\"invoice_date\"" space ":" space invoice-date
invoice-number-kv ::= "\"invoice_number\"" space ":" space string
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)? space
payment-terms-kv ::= "\"payment_terms\"" space ":" space string
payment-terms-rest ::= ( "," space iban-kv )?
root ::= "{" space invoice-number-kv "," space invoice-date-kv "," space customer-name-kv "," space total-amount-eur-kv ( "," space (  customer-address-kv customer-address-rest | service-description-kv service-description-rest | payment-terms-kv payment-terms-rest | iban-kv ) )? "}" space
service-description-kv ::= "\"service_description\"" space ":" space string
service-description-rest ::= ( "," space payment-terms-kv )? payment-terms-rest
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\"" space
total-amount-eur-kv ::= "\"total_amount_eur\"" space ":" space number
